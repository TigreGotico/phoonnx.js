{
  "name": "phoonnx",
  "version": "0.1.0",
  "description": "In-browser VITS TTS inference with onnxruntime-web. Unicode, espeak-ng and Python (Pyodide) front-end paths. No server, no API.",
  "keywords": [
    "tts",
    "text-to-speech",
    "onnx",
    "vits",
    "piper",
    "espeak",
    "browser",
    "wasm"
  ],
  "license": "Apache-2.0",
  "author": "TigreGóticoLda",
  "repository": {
    "type": "git",
    "url": "https://github.com/TigreGotico/phoonnx.js.git"
  },
  "homepage": "https://tigregotico.pt/demo",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./voices": {
      "types": "./dist/voices.d.ts",
      "import": "./dist/voices.js",
      "require": "./dist/voices.cjs"
    },
    "./espeak": {
      "types": "./dist/espeak.d.ts",
      "import": "./dist/espeak.js",
      "require": "./dist/espeak.cjs"
    },
    "./pyodide": {
      "types": "./dist/pyodide.d.ts",
      "import": "./dist/pyodide.js",
      "require": "./dist/pyodide.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "node test/browser/run.mjs",
    "prepare": "tsup"
  },
  "peerDependencies": {
    "onnxruntime-web": ">=1.18.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": false
    }
  },
  "devDependencies": {
    "espeak-ng": "^1.0.2",
    "onnxruntime-web": "^1.31.1",
    "playwright": "^1.65.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.0"
  }
}
